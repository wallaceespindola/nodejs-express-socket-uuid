{
  "name": "nodejs-express-socket-uuid",
  "version": "2.0.0",
  "description": "Realtime chat with Express 5 and Socket.IO 4 where users and messages get crypto.randomUUID() ids, plus a tiny REST API.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage"
  },
  "keywords": [
    "express",
    "socket.io",
    "uuid",
    "chat",
    "typescript",
    "websocket"
  ],
  "author": {
    "name": "Wallace Espindola",
    "email": "wallace.espindola@gmail.com",
    "url": "https://github.com/wallaceespindola/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wallaceespindola/nodejs-express-socket-uuid.git"
  },
  "bugs": {
    "url": "https://github.com/wallaceespindola/nodejs-express-socket-uuid/issues"
  },
  "homepage": "https://github.com/wallaceespindola/nodejs-express-socket-uuid#readme",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
